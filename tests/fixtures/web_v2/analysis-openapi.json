              },
              {
                "type": "null"
              }
            ],
            "title": "As Of"
          },
          "price": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Amount"
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "anyOf": [
              {
                "maxLength": 4096,
                "minLength": 0,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          },
          "status": {
            "enum": [
              "available",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "price",
          "as_of",
          "source"
        ],
        "title": "BtcReference",
        "type": "object"
      },
      "ClassLine": {
        "additionalProperties": false,
        "properties": {
          "asset_class": {
            "enum": [
