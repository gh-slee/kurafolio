          "calculation_id": {
            "maxLength": 64,
            "minLength": 64,
            "pattern": "^[0-9a-f]+$",
            "title": "Calculation Id",
            "type": "string"
          },
          "contract_version": {
            "const": 1,
            "title": "Contract Version",
            "type": "integer"
          },
          "cost": {
            "$ref": "#/components/schemas/Figure"
          },
          "crypto": {
            "$ref": "#/components/schemas/CryptoDetail"
          },
          "fact_generation": {
            "$ref": "#/components/schemas/FactGeneration"
          },
          "gaps": {
            "items": {
              "$ref": "#/components/schemas/GapItem"
            },
