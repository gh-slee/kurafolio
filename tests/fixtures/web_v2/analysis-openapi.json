{
  "components": {
    "schemas": {
      "Amount": {
        "additionalProperties": false,
        "properties": {
          "amount": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
            "title": "Amount",
            "type": "string"
          },
          "currency": {
            "pattern": "^[A-Z]{3}$",
            "title": "Currency",
            "type": "string"
          }
        },
        "required": [
          "amount",
          "currency"
        ],
        "title": "Amount",
        "type": "object"
      },
      "AnalysisAccount": {
        "additionalProperties": false,
        "properties": {
          "category": {
            "maxLength": 4096,
            "minLength": 0,
            "title": "Category",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "label": {
            "maxLength": 4096,
            "minLength": 0,
            "title": "Label",
            "type": "string"
          },
          "role": {
            "enum": [
              "investment",
              "crypto",
              "funding"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "category",
          "role"
        ],
        "title": "AnalysisAccount",
        "type": "object"
      },
      "AnalysisInstrument": {
        "additionalProperties": false,
        "properties": {
          "currency": {
            "anyOf": [
              {
                "pattern": "^[A-Z]{3}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Currency"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "SECURITY",
              "CASH",
              "CRYPTO",
              "UNSUPPORTED"
            ],
            "title": "Kind",
            "type": "string"
          },
          "mic": {
            "anyOf": [
              {
                "maxLength": 4096,
                "minLength": 0,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mic"
          },
          "network": {
            "anyOf": [
              {
                "maxLength": 4096,
                "minLength": 0,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Network"
          },
          "symbol": {
            "anyOf": [
              {
                "maxLength": 4096,
                "minLength": 0,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Symbol"
          },
          "ticker": {
            "anyOf": [
              {
                "maxLength": 4096,
                "minLength": 0,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ticker"
          }
        },
        "required": [
          "id",
          "kind",
          "currency",
          "ticker",
          "mic",
          "symbol",
          "network"
        ],
        "title": "AnalysisInstrument",
        "type": "object"
      },
      "AnalysisRow": {
