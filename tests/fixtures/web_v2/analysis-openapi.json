          },
          "gaps": {
            "items": {
              "enum": [
                "corporate_action_unresolved",
                "cost_currency_mixed",
                "cost_unavailable",
                "fx_unavailable",
                "quote_currency_mismatch",
                "quote_unavailable",
                "sale_shape_unsupported",
                "sales_exceed_purchases",
                "unsupported_position",
                "valuation_not_implemented",
                "value_unavailable"
              ],
              "type": "string"
            },
            "title": "Gaps",
            "type": "array"
          },
          "instrument": {
            "$ref": "#/components/schemas/AnalysisInstrument"
          },
          "quantity": {
            "anyOf": [
              {
                "maxLength": 256,
                "minLength": 1,
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quantity"
          },
          "unrealized_gain": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Amount"
              },
              {
                "type": "null"
              }
            ]
          },
          "unrealized_gain_converted": {
            "anyOf": [
              {
                "maxLength": 256,
                "minLength": 1,
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unrealized Gain Converted"
          },
          "value": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Amount"
              },
              {
                "type": "null"
              }
            ]
          },
          "value_as_of": {
            "anyOf": [
              {
                "maxLength": 4096,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value As Of"
          },
          "value_basis": {
            "anyOf": [
              {
                "enum": [
                  "quote",
                  "source_reported",
                  "par"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value Basis"
          },
          "value_converted": {
            "anyOf": [
              {
                "maxLength": 256,
                "minLength": 1,
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value Converted"
          }
        },
        "required": [
          "asset_class",
          "account",
          "instrument",
          "quantity",
          "btc_equivalent",
          "value",
          "value_converted",
          "value_basis",
          "value_as_of",
          "cost",
          "cost_converted",
          "cost_status",
          "book_cost_cad",
          "unrealized_gain",
          "unrealized_gain_converted",
          "codes",
          "gaps"
        ],
