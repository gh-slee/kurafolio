      "CryptoAnalysis": {
        "additionalProperties": false,
        "properties": {
          "assumptions": {
            "items": {
              "enum": [
                "acquisitions_assumed_held",
                "crypto_fees_not_deducted",
                "missing_from_newer_snapshot_is_sold",
