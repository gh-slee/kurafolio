        "required": [
          "contract_version",
          "calculation_id",
          "fact_generation",
          "valuation_time",
          "report_currency",
          "references",
          "value",
          "cost",
          "unrealized_gain",
          "lines",
          "rows",
          "observations",
          "assumptions",
          "gaps",
          "scope",
          "crypto"
