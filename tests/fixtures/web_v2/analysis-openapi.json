        "title": "CryptoAnalysis",
        "type": "object"
      },
      "CryptoDetail": {
        "additionalProperties": false,
        "properties": {
          "activities": {
            "items": {
              "$ref": "#/components/schemas/CountedActivityRow"
            },
            "title": "Activities",
            "type": "array"
          },
          "basis": {
            "const": "acquisitions_assumed_held",
