              },
              {
                "type": "null"
              }
            ],
            "title": "Btc Equivalent Quantity"
          },
          "excluded": {
            "additionalProperties": {
              "minimum": 0.0,
              "type": "integer"
            },
            "propertyNames": {
              "enum": [
                "pending",
                "cancelled",
                "unsupported",
                "void",
                "mirror",
                "not_acquisition",
                "non_crypto_purchase",
                "balance_observation"
              ]
            },
            "title": "Excluded",
            "type": "object"
          },
          "purchase_rate": {
            "$ref": "#/components/schemas/PurchaseRate"
          },
          "purchases_counted": {
            "minimum": 0.0,
            "title": "Purchases Counted",
            "type": "integer"
          },
          "sales_counted": {
            "title": "Sales Counted",
            "type": "boolean"
          },
          "sales_counted_count": {
            "minimum": 0.0,
            "title": "Sales Counted Count",
            "type": "integer"
          },
          "spending": {
            "$ref": "#/components/schemas/Figure"
          },
          "state": {
            "enum": [
              "tracked",
              "no_eligible_acquisitions"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "basis",
          "state",
          "btc_equivalent_quantity",
          "purchases_counted",
          "sales_counted",
          "sales_counted_count",
          "excluded",
          "activities",
          "spending",
          "purchase_rate"
        ],
        "title": "CryptoDetail",
        "type": "object"
      },
