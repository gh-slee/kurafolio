            "type": "array"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/ClassLine"
            },
            "title": "Lines",
            "type": "array"
          },
          "observations": {
            "items": {
              "$ref": "#/components/schemas/Observation"
