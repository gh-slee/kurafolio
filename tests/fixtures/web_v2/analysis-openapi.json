            "title": "Codes",
            "type": "array"
          },
          "cost": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Amount"
              },
              {
                "type": "null"
              }
            ]
          },
          "cost_converted": {
            "anyOf": [
              {
                "maxLength": 256,
                "minLength": 1,
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
