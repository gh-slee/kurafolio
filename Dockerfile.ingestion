ARG SOURCE_BASE
FROM docker:29.6.1-cli@sha256:862099ada15c669000bef53aa4cb9d821262829f45b0dda2159ccb276443043b AS dockercli
FROM ${SOURCE_BASE}
USER root
COPY --from=dockercli /usr/local/bin/docker /usr/local/bin/docker
COPY src /app/src
COPY requirements-pg.lock /tmp/requirements-pg.lock
RUN pip install --no-cache-dir --disable-pip-version-check -r /tmp/requirements-pg.lock
RUN mkdir -p /var/lib/kurafolio-launcher /var/lib/kurafolio-worker \
    && chown 10001:10001 /var/lib/kurafolio-launcher /var/lib/kurafolio-worker \
    && chmod 0700 /var/lib/kurafolio-launcher /var/lib/kurafolio-worker
USER 10001:10001
